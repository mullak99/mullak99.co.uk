{
	"name": "mullak99.co.uk",
	"version": "0.0.1",
	"license": "MIT",
	"scripts": {
		"dev": "svelte-kit sync && vite dev --host",
		"build": "pnpm update-browsers && vite build && pnpm postbuild",
		"postbuild": "npx svelte-sitemap --domain https://mullak99.co.uk",
		"preview": "vite preview",
		"update-browsers": "npx update-browserslist-db@latest",
		"test": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-brands-svg-icons": "^7.3.1",
		"@fortawesome/free-regular-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@fortawesome/svelte-fontawesome": "^0.2.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/eslint": "^9.6.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.5",
		"svelte-sitemap": "^3.2.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4"
	},
	"type": "module",
	"packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
